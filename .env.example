# ---- MongoDB ----
# Your Atlas cluster. Replace <db_username>/<db_password> with the real DB user
# credentials, and keep the /project_hub database name before the query string.
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/project_hub?retryWrites=true&w=majority&appName=Cluster0"

# ---- NextAuth ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Google OAuth app -> https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (local):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod):   https://<your-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only needed if auto-detection fails (set to your prod URL on Vercel)
# AUTH_URL="https://<your-app>.vercel.app"

# ---- Allowlist (optional) ----
# Comma-separated emails allowed to sign in. Leave empty to allow anyone with a
# Google account. Also accepts domains like "@yourcompany.com".
ALLOWED_EMAILS=""

# ---- Dev login (optional, local only) ----
# "true" adds an email-only sign-in form so you can use the app before setting
# up Google OAuth. It is ignored whenever NODE_ENV=production, so it has no
# effect on Vercel. Leave empty/false once Google OAuth works.
ALLOW_DEV_LOGIN=""

# ---- LLM providers ----
# At least one is required for the AI features.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Which provider the UI selects by default: "anthropic" | "openai"
DEFAULT_LLM_PROVIDER="anthropic"
